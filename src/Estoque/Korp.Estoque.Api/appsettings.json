{
  "Logging":
  {
    "LogLevel":
    {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "CORS":
  {
    "AllowedOrigins":
    [
      "https://dominio-do-frontend-A",
      "https://dominio-do-frontend-B"
    ]
  },
  "RateLimiting":
  {
    "PermitLimit": 100,
    "WindowInMinutes": 1,
    "QueueLimit": 2
  }
}
